# Poopidex — environment variables
# Copy this file to `.env.local` and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Anthropic Claude (required) -------------------------------------------
# Used as the AI fallback when the YOLO model is unsure about a photo.
# Get a key at https://console.anthropic.com → Settings → API Keys.
# Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- YOLO inference server URL (optional, has sensible default) ------------
# URL of the Python YOLO inference server (FastAPI + Ultralytics).
# Defaults to http://127.0.0.1:8001/predict if unset (good for local dev).
# In production, point to the deployed Hugging Face Space, e.g.
# https://yourname-poopidex-yolo.hf.space/predict
YOLO_API_URL=http://127.0.0.1:8001/predict
